{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "maildrop",
    "main": "worker/index.ts",
    "compatibility_date": "2026-10-01",
    "observability": {
        "enabled": true,
    },

    // React SPA. /api/* and the HTML pages run the Worker first (the Worker fills in absolute
    // canonical/Open Graph URLs); everything else is a static asset, with index.html as the
    // fallback for client-side routes like /inbox/<name>.
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/", "/index.html", "/inbox/*"],
    },

    // With no routes the Worker is served on <name>.<your-subdomain>.workers.dev.
    // To serve the UI on your own hostname (usually the one that receives mail), uncomment
    // and set your host. Wrangler creates the DNS record for a custom domain.
    // "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],

    "durable_objects": {
        "bindings": [
            { "name": "INBOX", "class_name": "InboxDurableObject" },
            { "name": "REGISTRY", "class_name": "InboxRegistry" },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["InboxDurableObject", "InboxRegistry"],
        },
    ],

    // Backup sweep for expired inboxes (alarms are the primary mechanism).
    "triggers": {
        "crons": ["*/30 * * * *"],
    },

    // Per-client-IP limits. namespace_id must be unique within your Cloudflare account.
    "ratelimits": [
        {
            "name": "API_LIMITER",
            "namespace_id": "71001",
            "simple": { "limit": 300, "period": 60 },
        },
        {
            "name": "CREATE_LIMITER",
            "namespace_id": "71002",
            "simple": { "limit": 10, "period": 60 },
        },
    ],

    "vars": {
        // Must match "name" above: per-address Email Routing rules send mail to this Worker.
        "EMAIL_WORKER_NAME": "maildrop",
        "MAX_INBOX_BYTES": "52428800",
        "MAX_MESSAGE_BYTES": "10485760",
        "MAX_MESSAGES_PER_INBOX": "100",
        // Optional. Domain that inboxes receive mail at. Defaults to the host of SITE_URL,
        // then the host the UI is opened on (or, for inbound mail, the recipient's domain).
        // "MAIL_DOMAIN": "mail.example.com",
        // Optional. Public origin for canonical/Open Graph URLs. Defaults to the request origin.
        // "SITE_URL": "https://mail.example.com",
        // ZONE_ID, CF_TOKEN and ADMIN_TOKEN are secrets: see .dev.vars.example.
    },
}
